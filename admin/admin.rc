// Icon and name of CalendarServerAdmin.exe for Explorer, the taskbar and the
// Task Manager. IDI_ICON1 is the name Qt looks for, so the window gets the
// icon too. The icon is the planner's, as for the server's installer.
#pragma code_page(65001)
#include <winver.h>

IDI_ICON1 ICON "../packaging/windows/CalendarServer.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,3,0,0
PRODUCTVERSION 1,3,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904B0"
        BEGIN
            VALUE "FileDescription", "Админ-панель сервера Космос календаря"
            VALUE "FileVersion", "1.3.0"
            VALUE "InternalName", "CalendarServerAdmin"
            VALUE "OriginalFilename", "CalendarServerAdmin.exe"
            VALUE "ProductName", "Космос календарь"
            VALUE "ProductVersion", "1.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0419, 1200
    END
END
