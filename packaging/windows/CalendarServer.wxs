<?xml version="1.0" encoding="utf-8"?>
<!--
  MSI of the sync server for 64-bit Windows, built by build-installer.bat (WiX 3):

      heat    harvests the server and the admin panel laid out by windeployqt
              into ServerFiles - all but CalendarServer.exe, which is the file
              of the service component below
      candle  -arch x64 -dVersion=... -dSourceDir=... -dServiceExe=... -dIconFile=...
              -ext WixUtilExtension -ext WixFirewallExtension
      light   -cultures:ru-ru -ext WixUIExtension -ext WixUtilExtension
              -ext WixFirewallExtension

  The server becomes the Windows service CosmosCalendarServer: it starts with
  the system as LocalService, with no console, and right after installation.
  Its settings, base and log live in %ProgramData%\CalendarPlanner\CalendarServer,
  open to administrators and to the service only. The shortcuts are those of
  the admin panel (CalendarServerAdmin.exe), which starts and stops the service
  and works with the base.

  A server of an older version ran in a console with its base in the data
  folder of the user. The installer stops it and the service takes a copy of
  that base, once, while it has no accounts of its own (the import-db option). The old
  base itself is left untouched, and so is the base of the service when the
  program is removed: server.ini and the data folder are permanent.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension"
     xmlns:fw="http://schemas.microsoft.com/wix/FirewallExtension">

  <?ifndef Manufacturer ?>
    <?define Manufacturer = "SayxZero" ?>
  <?endif ?>

  <!-- The UpgradeCode ties every version together; it must never change. -->
  <Product Id="*"
           Name="Космос календарь: сервер синхронизации"
           Language="1049"
           Codepage="1251"
           Version="$(var.Version)"
           Manufacturer="$(var.Manufacturer)"
           UpgradeCode="E5C5CBAF-8586-4AB8-A5A9-CC827F3D79DD">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64"
             Languages="1049"
             SummaryCodepage="1251"
             Description="CalendarServer $(var.Version)"
             Comments="Сервер синхронизации Космос календаря" />

    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="Уже установлена более новая версия сервера синхронизации. Сначала удалите её." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="ServerIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="ServerIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/SayxZero/CalendarServer" />
    <Property Id="ARPHELPLINK" Value="https://github.com/SayxZero/CalendarServer" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="CalendarServer" />
      </Directory>
      <Directory Id="CommonAppDataFolder">
        <Directory Id="PlannerDataFolder" Name="CalendarPlanner">
          <Directory Id="DATAFOLDER" Name="CalendarServer" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
      <Directory Id="DesktopFolder" />
    </Directory>

    <!-- The server itself, as a service. Its own component: the service, the
         firewall rule and the file have to come and go together. The rule is
         for the program, whatever port server.ini gives it, on private
         networks - a home network the way Windows calls it. -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="ServerService" Guid="7D4752E3-C87A-4553-BCAE-C644DE89B0C3">
        <File Id="ServerExe" Name="CalendarServer.exe" Source="$(var.ServiceExe)" KeyPath="yes">
          <fw:FirewallException Id="ServerFirewall"
                                Name="Космос календарь: сервер синхронизации"
                                Description="Планеры в домашней сети подключаются к серверу синхронизации."
                                Profile="private"
                                Scope="any"
                                IgnoreFailure="yes" />
        </File>
        <ServiceInstall Id="ServerService"
                        Name="CosmosCalendarServer"
                        DisplayName="Космос календарь: сервер синхронизации"
                        Description="Хранит аккаунты планеров Космос календаря и раздаёт их изменения устройствам. Управляется админ-панелью сервера."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="NT AUTHORITY\LocalService"
                        Arguments="--service --config &quot;[DATAFOLDER]server.ini&quot;"
                        Vital="yes">
          <!-- A crash is followed by a restart; the third one in a day stops it,
               and the admin panel shows why from the log. -->
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="none"
                              RestartServiceDelayInSeconds="10"
                              ResetPeriodInDays="1" />
        </ServiceInstall>
        <!-- Stopping waits: the files of the service are replaced after it.
             Starting does not: a server that cannot start (a busy port) is not
             a reason to roll the installation back - the admin panel says
             what happened, and the log says why. -->
        <ServiceControl Id="StopServer" Name="CosmosCalendarServer" Stop="both" Remove="uninstall" Wait="yes" />
        <ServiceControl Id="StartServer" Name="CosmosCalendarServer" Start="install" Wait="no" />
      </Component>
    </DirectoryRef>

    <!-- The data folder: settings, base, log and backups. Only the system,
         administrators and the service (LocalService, read and write) get in:
         the base holds every account. The settings are the user's once
         written - kept on upgrades and left behind with the base. -->
    <DirectoryRef Id="DATAFOLDER">
      <Component Id="ServerSettings" Guid="E138CDC7-026E-4805-82FB-32DC743DF232"
                 Permanent="yes" NeverOverwrite="yes">
        <File Id="ServerIni" Name="server.ini" Source="$(var.PackagingDir)\service.ini" KeyPath="yes" />
        <CreateFolder>
          <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1301bf;;;LS)" />
        </CreateFolder>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="AdminStartMenuShortcut" Guid="89335F87-285B-4DEC-9EE6-A73BA3230E23">
        <Condition>INSTALLSTARTMENUSHORTCUT = 1</Condition>
        <Shortcut Id="AdminStartMenuShortcut"
                  Name="Админ-панель сервера Космос календаря"
                  Description="Состояние сервера синхронизации, аккаунты, резервные копии и статистика"
                  Target="[INSTALLFOLDER]CalendarServerAdmin.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="ServerIcon" />
        <RegistryValue Root="HKCU" Key="Software\Cosmos Calendar\Installer"
                       Name="AdminStartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="AdminDesktopShortcut" Guid="BDAFBA58-EBD7-4442-9C84-6FAFC4A22AE1">
        <Condition>INSTALLDESKTOPSHORTCUT = 1</Condition>
        <Shortcut Id="AdminDesktopShortcut"
                  Name="Админ-панель сервера Космос календаря"
                  Description="Состояние сервера синхронизации, аккаунты, резервные копии и статистика"
                  Target="[INSTALLFOLDER]CalendarServerAdmin.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="ServerIcon" />
        <RegistryValue Root="HKCU" Key="Software\Cosmos Calendar\Installer"
                       Name="AdminDesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Server" Title="CalendarServer" Level="1" Absent="disallow">
      <ComponentGroupRef Id="ServerFiles" />
      <ComponentRef Id="ServerService" />
      <ComponentRef Id="ServerSettings" />
      <ComponentRef Id="AdminStartMenuShortcut" />
      <ComponentRef Id="AdminDesktopShortcut" />
    </Feature>

    <!-- A server of an older version, running in a console from this folder,
         holds the port the service needs and the files being replaced. It is
         closed before InstallValidate, so that the files are not even found
         in use. Only processes of a user's session: the service of an older
         version runs in session 0 and is stopped by its own ServiceControl.
         The command stays under 255 characters, the size of the column
         (ICE03), hence the short spelling of PowerShell. -->
    <SetProperty Id="QtExecCmdLine" Before="StopOldServer" Sequence="execute"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -Command &quot;Get-Process CalendarServer -EA 0 | ? SessionId -ne 0 | ? Path -eq '[INSTALLFOLDER]CalendarServer.exe' | Stop-Process -Force&quot;" />
    <CustomAction Id="StopOldServer" BinaryKey="WixCA" DllEntry="CAQuietExec64"
                  Execute="immediate" Return="ignore" />

    <!-- The base of the console server, from the data folder of whoever
         installs, goes to the service while the service has no accounts yet.
         The server itself does it (its import-db option, a consistent copy of a
         base in use); what it did is in server.log. -->
    <CustomAction Id="ImportOldDatabase" FileKey="ServerExe"
                  ExeCommand="--import-db &quot;[AppDataFolder]CalendarPlanner\CalendarServer\server.db&quot; --config &quot;[DATAFOLDER]server.ini&quot;"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="StopOldServer" Before="InstallValidate">NOT REMOVE~="ALL"</Custom>
      <Custom Action="ImportOldDatabase" After="InstallFiles">NOT REMOVE~="ALL"</Custom>
    </InstallExecuteSequence>

    <!-- "Open the admin panel" on the last page, in the user's own process:
         the panel asks for the rights of an administrator itself. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Открыть админ-панель сервера" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="LaunchAdmin" BinaryKey="WixCA" DllEntry="WixShellExec" Impersonate="yes" />

    <!-- The pictures of the dialogs instead of the red ones of WiX: drawn with
         the logo by tools/icons/make-icons.bat of the planner. -->
    <WixVariable Id="WixUIDialogBmp" Value="$(var.PackagingDir)\msi-dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.PackagingDir)\msi-banner.bmp" />

    <!-- "Ярлыки": a page of its own between the folder and "Ready to install",
         with the two checkboxes. The stock WixUI_InstallDir goes from
         InstallDirDlg straight to VerifyReadyDlg; a NewDialog of a higher
         Order on the same button wins, and VerifyReadyDlg's Back comes here.
         Unticked, a checkbox deletes its property, so the conditions of the
         shortcut components read "= 1": that also turns a 0 handed in by
         setup.exe into "no". -->
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" />
    <Property Id="INSTALLSTARTMENUSHORTCUT" Value="1" />
    <UI>
      <Dialog Id="ShortcutsDlg" Width="370" Height="270" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Ярлыки" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Где создать иконки админ-панели сервера." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="DesktopCheckbox" Type="CheckBox" X="20" Y="60" Width="330" Height="18" Property="INSTALLDESKTOPSHORTCUT" CheckBoxValue="1" Text="Добавить иконку админ-панели на &amp;рабочий стол" />
        <Control Id="StartMenuCheckbox" Type="CheckBox" X="20" Y="84" Width="330" Height="18" Property="INSTALLSTARTMENUSHORTCUT" CheckBoxValue="1" Text="Добавить иконку админ-панели в меню «П&amp;уск»" />
        <Control Id="ServiceNote" Type="Text" X="20" Y="116" Width="330" Height="54" NoPrefix="yes" Text="Сам сервер установится службой Windows: он работает без окна, запускается вместе с системой и сразу после установки. Запускает, останавливает и показывает его админ-панель." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="InstallDirDlg">1</Publish>
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>
    </UI>

    <!-- The stock dialog set without its licence page, as in the planner. -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <UI>
      <UIRef Id="WixUI_InstallDir" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ShortcutsDlg" Order="5">WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID="1"</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ShortcutsDlg" Order="2">NOT Installed</Publish>
      <Publish Dialog="ExitDialog" Control="Finish" Property="WixShellExecTarget"
               Value="[INSTALLFOLDER]CalendarServerAdmin.exe" Order="1">1</Publish>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchAdmin" Order="2">
        WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed
      </Publish>
    </UI>
  </Product>
</Wix>
