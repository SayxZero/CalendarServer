<?xml version="1.0" encoding="utf-8"?>
<!--
  Russian strings of WixFirewallExtension: WiX 3.7 ships them in English only,
  and light, building the MSI for ru-ru, stops on every missing one (LGHT0102).
  The ids are those the extension's own wixlib asks for.
-->
<WixLocalization Culture="ru-ru" Language="1049" xmlns="http://schemas.microsoft.com/wix/2006/localization">
  <String Id="WixSchedFirewallExceptionsInstall">Подготовка правил брандмауэра Windows</String>
  <String Id="WixSchedFirewallExceptionsUninstall">Подготовка удаления правил брандмауэра Windows</String>
  <String Id="WixExecFirewallExceptionsInstall">Добавление правил брандмауэра Windows</String>
  <String Id="WixExecFirewallExceptionsUninstall">Удаление правил брандмауэра Windows</String>
  <String Id="WixRollbackFirewallExceptionsInstall">Откат правил брандмауэра Windows</String>
  <String Id="WixRollbackFirewallExceptionsUninstall">Возврат правил брандмауэра Windows</String>
  <String Id="msierrFirewallCannotConnect">Не удалось подключиться к брандмауэру Windows. ([2] [3] [4] [5])</String>
</WixLocalization>
