CTestTestfile.cmake
_deps/
*_autogen/
CMakeUserPresets.json
compile_commands.json

# Server data and the config of a particular machine. The database lands where
# -d or data_dir points, which may be inside the tree (data_dir=data next to a
# server.ini here); server.ini is the filled in copy of
# deploy/server.ini.example, and only the example is tracked.
*.db
*.db-journal
*.db-wal
*.db-shm
/data/
server.ini
*.log

# Test output written next to the sources (tst_server -o out.txt,txt)
/out.txt
/result.txt

# IDE and editors
*.pro.user*
CMakeLists.txt.user*
.qtc_clangd/
.qtcreator/
*.autosave
.vscode/
.idea/
.vs/
*.user
.cache/
*.swp
*~

